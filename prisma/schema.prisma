generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model campaign {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug            String            @unique @db.VarChar(100)
  edit_token      String            @db.VarChar(100)
  institution_id  String            @db.Uuid
  patient_name    String            @db.VarChar(255)
  blood_type      String            @db.VarChar(10)
  donation_type   String?           @default("Sangre entera") @db.VarChar(50)
  target_donors   Int?
  current_donors  Int?              @default(0)
  deadline        DateTime?         @db.Date
  observations    String?
  generated_copy  String?
  status          campaign_status   @default(DRAFT)
  created_at      DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at      DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  institution     institution       @relation(fields: [institution_id], references: [id], onUpdate: NoAction)
  campaign_asset  campaign_asset[]
  campaign_metric campaign_metric[]
  download_log    download_log[]

  @@index([institution_id], map: "idx_campaign_institution")
  @@index([slug], map: "idx_campaign_slug")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model campaign_asset {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaign_id String       @db.Uuid
  format      asset_format
  image_url   String
  width       Int
  height      Int
  created_at  DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  campaign    campaign     @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([campaign_id], map: "idx_campaign_asset_campaign")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model campaign_metric {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaign_id String   @db.Uuid
  visited_at  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  device_type String?  @default("UNKNOWN") @db.VarChar(20)
  referrer    String?  @default("DIRECT") @db.VarChar(50)
  ip_hash     String?  @db.VarChar(64)
  campaign    campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([campaign_id], map: "idx_campaign_metric_campaign")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model download_log {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaign_id   String        @db.Uuid
  download_type download_type
  downloaded_at DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  ip_hash       String?       @db.VarChar(64)
  campaign      campaign      @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model faq_item {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  institution_id String?      @db.Uuid
  question       String       @db.VarChar(255)
  answer         String
  category       String       @default("GENERAL") @db.VarChar(50)
  display_order  Int          @default(0)
  institution    institution? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([institution_id], map: "idx_faq_item_institution")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model institution {
  id                    String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String        @db.VarChar(255)
  address               String        @db.VarChar(255)
  city                  String        @default("Buenos Aires") @db.VarChar(100)
  phone                 String?       @db.VarChar(50)
  whatsapp              String?       @db.VarChar(50)
  email                 String?       @db.VarChar(100)
  website_url           String?
  requirements_url      String?
  faq_url               String?
  business_hours        Json?         @default("{\"dias\": \"Lunes a Viernes\", \"horario\": \"08:00 a 12:00\"}")
  specific_requirements String?
  logo_url              String?
  is_active             Boolean       @default(true)
  created_at            DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  campaign              campaign[]
  faq_item              faq_item[]
  requirement           requirement[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model requirement {
  id                            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  institution_id                String?      @db.Uuid
  title                         String       @db.VarChar(255)
  description                   String
  is_immediate_disqualification Boolean      @default(false)
  category                      String       @default("GENERAL") @db.VarChar(50)
  display_order                 Int          @default(0)
  institution                   institution? @relation(fields: [institution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([institution_id], map: "idx_requirement_institution")
}

enum asset_format {
  SQUARE_1_1
  STORY_9_16
}

enum campaign_status {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum download_type {
  IMAGE_1_1
  IMAGE_9_16
  ZIP_BUNDLE
}
