# Puerto del servidor (en Render lo define la plataforma)
PORT=3000

# Conexión a Postgres vía Connection Pooler (Transaction mode). Se copia desde Supabase → Connect
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión Session mode para migraciones
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>.pooler.supabase.com:5432/postgres"

# Opcional: orígenes extra permitidos por CORS, separados por comas
FRONTEND_URL=
