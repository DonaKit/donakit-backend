# Puerto del servidor (en Render lo define la plataforma)
PORT=

# Conexión a Postgres vía Connection Pooler (Transaction mode, Supabase)
DATABASE_URL=

# Conexión directa / Session mode para migraciones de Prisma
DIRECT_URL=

# URL del proyecto en Supabase
SUPABASE_URL=

# Clave pública (Publishable / Anon Key) de Supabase
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta / Service Role de Supabase
SUPABASE_SECRET_KEY=

# Nombre del bucket en Supabase Storage para placas
SUPABASE_STORAGE_BUCKET=

# Orígenes permitidos para CORS (lista separada por comas, sin barra final)
FRONTEND_URL=

# Secreto compartido con el frontend para validar JWTs administrativos (HS256)
JWT_SECRET=

# Opcional: lista de correos administradores autorizados (separados por comas)
ADMIN_EMAILS=
